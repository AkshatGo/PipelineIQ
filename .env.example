# Application
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pipelineiq
DATABASE_CONNECT_ON_STARTUP=true
DATABASE_REQUIRED_AT_STARTUP=false

# Authentication (replace every placeholder before enabling authentication)
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=piq_session
COOKIE_SECURE=false
COOKIE_DOMAIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user read:org

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_WEBHOOK_MAX_BYTES=10000000

# Optional providers
OPENAI_API_KEY=
GROQ_API_KEY=
GITHUB_TOKEN=
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Kafka remains optional; inline processing is the local default.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Frontend
VITE_API_URL=http://localhost:8000/api
